# Django core settings
SECRET_KEY=replace-with-a-random-local-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Optional P2: Telegram Bot Interactive Alerts (F4.4)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=dev-webhook-secret
APP_BASE_URL=http://127.0.0.1:8000

# Optional P3: Gemini AI/LLM Fallbacks (F3.4, F4.5)
# Leave blank to run 100% offline with built-in smart templates
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

